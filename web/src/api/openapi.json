{
  "openapi": "3.1.0",
  "info": {
    "title": "VisionQuery",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Whether the Deployment is ready to serve: its database can be reached",
        "description": "Readiness, not liveness: 200 only while the api can do its work.\n\nA running api that cannot reach the database answers 503 here, so the Compose\nhealthcheck (which asks this) marks it unhealthy rather than letting an api that\ncan answer nothing look fine. The body names the problem by category only. Before the\nfirst look at the database has finished it is not ready either, but claims no problem.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConnectionProblem": {
        "type": "string",
        "enum": [
          "authentication failed",
          "database does not exist",
          "server is not accepting connections",
          "server has too many connections",
          "host name could not be resolved",
          "TLS required or failed",
          "server rejected a startup option",
          "timed out",
          "connection refused or host unreachable",
          "other connection failure"
        ]
      },
      "DatabaseStatus": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "connected",
              "unreachable",
              "checking"
            ],
            "title": "Status"
          },
          "problem": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConnectionProblem"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "problem"
        ],
        "title": "DatabaseStatus",
        "description": "Whether the api can reach the Deployment's database, and if not, why.\n\n\"checking\" while the first look at it has not finished, when nothing is known yet."
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "unhealthy"
            ],
            "title": "Status"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "Health",
        "description": "Whether the api is ready to serve: ready only when everything it depends on is reachable."
      }
    }
  }
}
