; The package boundaries from CLAUDE.md, as import contracts.
;
;   uv run lint-imports        exits non-zero on a violation
;
; Enforced by `make check` and by the test suite now, and by CI once #8 lands.
; tests/test_import_contracts.py proves each contract reports the import it forbids and
; keeps the legal paths legal, and that `allow_indirect_imports` is on only where a
; contract must tolerate paths through another package (and off where it must not).

[importlinter]
root_package = visionquery
include_external_packages = True

; Perception and recording run on every frame of every camera. Nothing they do may
; depend on asking questions or serving them, so a slow or broken Reasoner or api can
; never stall what is being remembered.

[importlinter:contract:no-reaching-up]
name = Perception and the recorder never import the reasoner or the api
type = forbidden
source_modules =
    visionquery.perception
    visionquery.recorder
forbidden_modules =
    visionquery.reasoner
    visionquery.api

; ADR 0006 - one Postgres, and memory is the only code that talks to it. The common
; Postgres drivers and adapters are listed (a driver not listed here needs adding), so
; picking a different one does not open a side door. Indirect imports are allowed:
; tools -> memory -> psycopg is how every other package is meant to reach the database,
; and only a package naming a driver itself is the violation.

[importlinter:contract:only-memory-holds-a-driver]
name = Only memory imports a database driver
type = forbidden
source_modules =
    visionquery.runtime
    visionquery.tools
    visionquery.perception
    visionquery.linker
    visionquery.recorder
    visionquery.reasoner
    visionquery.api
forbidden_modules =
    psycopg
    psycopg_pool
    psycopg2
    asyncpg
    pg8000
    sqlalchemy
    pgvector
allow_indirect_imports = True

; ADR 0009 - the Reasoner sees the memory only through the typed tools, so every fact
; it gets carries Evidence. The path reasoner -> tools -> memory (or -> linker) is the
; one this contract exists to force, so indirect imports are allowed; the reasoner
; naming memory, linker, perception, recorder or api itself is not. The runtime is
; not forbidden: every process, the reasoner included, starts with it.
;
; Known limits: a tools module re-exporting a memory symbol is not detected, and neither
; is a dynamic import (importlib.import_module). Review catches those.

[importlinter:contract:reasoner-through-tools]
name = The reasoner reaches the memory only through tools
type = forbidden
source_modules =
    visionquery.reasoner
forbidden_modules =
    visionquery.memory
    visionquery.linker
    visionquery.perception
    visionquery.recorder
    visionquery.api
allow_indirect_imports = True

; ADR 0009 - Operator operations go through the typed tools, so the api does not name the
; memory or the linker itself; api -> tools -> memory stays legal (allow_indirect_imports).
; The ignored imports are the one exception, each named: the health probe asks the database
; whether it can be reached, and the process reads the database settings. Anything else
; the api needs from the memory belongs in a tool.

[importlinter:contract:api-through-tools]
name = The api reaches the memory only through tools, except its health probe
type = forbidden
source_modules =
    visionquery.api
forbidden_modules =
    visionquery.memory
    visionquery.linker
allow_indirect_imports = True
ignore_imports =
    visionquery.api.probe -> visionquery.memory.health
    visionquery.api.serve -> visionquery.memory.health
    visionquery.api.serve -> visionquery.memory.settings

; The runtime is what every process starts with (settings, logs, metrics), so every
; package may import it, and it may import none of them: a foundation that reached up
; would make every package depend on every other. Its database-driver ban is in
; [only-memory-holds-a-driver].

[importlinter:contract:runtime-is-a-foundation]
name = The runtime imports no other VisionQuery package
type = forbidden
source_modules =
    visionquery.runtime
forbidden_modules =
    visionquery.memory
    visionquery.tools
    visionquery.perception
    visionquery.linker
    visionquery.recorder
    visionquery.reasoner
    visionquery.api
