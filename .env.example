# Settings for `docker compose` (compose.yaml). Copy this file to `.env`, which git ignores,
# and fill in every empty value: those are the secrets, and Compose refuses to start
# without them. Generate each with `openssl rand -hex 24`; any characters are fine.

# The address the ports of Postgres, the control API of MediaMTX, Triton, Prometheus and Grafana
# listen on. Keep it on loopback: none of them is meant for the network (Prometheus has no
# authentication at all).
VISIONQUERY_BIND_ADDRESS=127.0.0.1
# The address MediaMTX's camera-facing ports (RTSP, and WebRTC's signalling and media) listen on.
# Loopback keeps them to this machine; set 0.0.0.0 (or one interface's address) when cameras
# elsewhere publish into MediaMTX, and nothing else is opened with it.
# WARNING: until milestone M1 tightens MediaMTX, anyone who can reach these ports can publish to
# and read every path, so do not bind beyond loopback on a network you do not trust.
VISIONQUERY_MEDIAMTX_BIND_ADDRESS=127.0.0.1

# Log level of every VisionQuery process: DEBUG, INFO, WARNING, ERROR or CRITICAL.
VISIONQUERY_LOG_LEVEL=INFO

# Password of the `visionquery` superuser of Postgres, which owns the memory's database.
VISIONQUERY_POSTGRES_PASSWORD=
# Host port of Postgres (5432 in the container); not 5432, which a local Postgres often holds.
VISIONQUERY_POSTGRES_PORT=15432

# Password of the `visionquery` user of MediaMTX's API, which VisionQuery's processes use.
VISIONQUERY_MEDIAMTX_API_PASSWORD=
# Host port of MediaMTX's RTSP server, where cameras publish and processes read.
VISIONQUERY_MEDIAMTX_RTSP_PORT=8554
# Host port of MediaMTX's control API.
VISIONQUERY_MEDIAMTX_API_PORT=9997
# Host port of MediaMTX's WebRTC server (the live view's signalling, over HTTP).
VISIONQUERY_MEDIAMTX_WEBRTC_PORT=8889
# UDP port of WebRTC media, the same on the host and in the container because MediaMTX announces
# the container's number to the browser.
VISIONQUERY_MEDIAMTX_WEBRTC_UDP_PORT=8189
# Comma-separated addresses the browser sends WebRTC media to: this machine's address as the
# browser reaches it. 127.0.0.1 suits a browser on this machine; list the host's LAN address or
# name for a browser elsewhere. Without a reachable one the live view connects but shows nothing.
VISIONQUERY_MEDIAMTX_WEBRTC_HOSTS=127.0.0.1

# The fake cameras (dev profile), comma-separated as name=video, one camera each: as many as
# wanted, and several may loop the same video. The name is the camera's MediaMTX path, read at
# rtsp://127.0.0.1:8554/<name>; the video is a file in VISIONQUERY_FAKE_CAMERA_SAMPLES, such as
# those `make fetch-samples` downloads (listed in samples/manifest.toml), or `synthetic` for a
# test pattern that needs none. A video that is not there yet (or that the container cannot
# read) gets the test pattern meanwhile, and a camera that starts on it switches to its prepared
# sample when that is ready, which disconnects a viewer once: reconnect it to see the sample.
VISIONQUERY_FAKE_CAMERAS=gym-g299=meva-school-g299.avi,gym-g330=meva-school-g330.avi,stairs-g420=meva-school-g420.avi
# Seconds every video is cut to (or held for, if shorter), a whole number. Every fake camera
# shows the same moment of its video as every other: they follow the wall clock from the Unix
# epoch, so with 300 s a loop starts at every five minutes of the hour, whenever the cameras
# started or restarted. Videos recorded together then stay in step, and the same footage
# repeats every DURATION seconds. Changing it prepares the videos again.
VISIONQUERY_FAKE_CAMERA_DURATION=300
# The directory the fake cameras read their videos from (dev profile), never written to.
VISIONQUERY_FAKE_CAMERA_SAMPLES=./samples

# Host port of Triton's HTTP API (gpu profile).
VISIONQUERY_TRITON_HTTP_PORT=8000
# Host port of Triton's gRPC API (gpu profile).
VISIONQUERY_TRITON_GRPC_PORT=8001

# Host port of Prometheus (observability profile).
VISIONQUERY_PROMETHEUS_PORT=9090
# Host port of Grafana (observability profile).
VISIONQUERY_GRAFANA_PORT=3000
# Password of Grafana's `admin` user (observability profile).
VISIONQUERY_GRAFANA_ADMIN_PASSWORD=
